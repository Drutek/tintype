# Public URL of this install (used in links, check runs, GitHub App and capture workers' Storybook URLs).
APP_URL=http://localhost:8080
# Generate with: docker compose run --rm web key
APP_KEY=
APP_NAME=Tintype

# Shared secret between the server and capture workers.
TINTYPE_WORKER_TOKEN=change-me-to-a-long-random-string

# Realtime (Reverb). Browsers connect to this host/port.
REVERB_APP_ID=tintype
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me-too
TINTYPE_REVERB_PUBLIC_HOST=localhost
TINTYPE_REVERB_PUBLIC_PORT=8081
TINTYPE_REVERB_PUBLIC_SCHEME=http

POSTGRES_PASSWORD=tintype
MINIO_ROOT_USER=tintype
MINIO_ROOT_PASSWORD=tintype-secret

# Allow anyone to sign up after the first admin (default: closed).
TINTYPE_OPEN_REGISTRATION=false
