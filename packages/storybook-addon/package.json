{
  "name": "@tintype/storybook-addon",
  "version": "0.1.0",
  "description": "Visual Tests panel for Storybook: run Tintype builds and review snapshot status per story",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/preset.js",
    "./preset": "./dist/preset.js",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "preset.js"],
  "repository": { "type": "git", "url": "https://github.com/drutek/tintype.git", "directory": "packages/storybook-addon" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tintype/cli": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "storybook": "^8.0.0 || ^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.3.1",
    "storybook": "^10.6.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "storybook": {
    "displayName": "Tintype Visual Tests",
    "supportedFrameworks": ["react", "vue", "angular", "svelte", "web-components", "preact", "html"]
  }
}
